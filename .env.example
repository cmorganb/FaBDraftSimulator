# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - packages/core never reads env vars directly
# (plan section 4.1: the pure core takes no I/O except injected ports); only
# the LLM agent layer (WP-16) and above should read these.

# DeepSeek API (OpenAI-compatible) - used for LLM agent testing instead of
# the plan's default Anthropic Messages API (plan section 8.3).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
