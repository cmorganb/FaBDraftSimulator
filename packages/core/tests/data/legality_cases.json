{
  "_comment": "Hand-checked card_playable_by cases (plan section 6.3, WP-06) for IAR's three draft heroes (plan S10, confirmed against real Card Vault data: Levia/Brute, Malice/Necromancer, 'Viserai, Between Worlds'/Runeblade, all Shadow-talent). Card names below are fictional (never real LSS card text); hero names/classes/talents are the real, grounded facts. See docs/status/WP-06.md.",
  "heroes": {
    "levia": { "name": "Levia", "classes": ["Brute"], "talents": ["Shadow"] },
    "malice": { "name": "Malice", "classes": ["Necromancer"], "talents": ["Shadow"] },
    "viserai": {
      "name": "Viserai, Between Worlds",
      "classes": ["Runeblade"],
      "talents": ["Shadow"]
    }
  },
  "banned_in_limited": ["banned-test-card-red"],
  "cases": [
    {
      "description": "Generic card (no classes/talents) is always legal - CR 2.14.1a",
      "hero": "levia",
      "card": { "uid": "generic-action-red", "classes": [], "talents": [] },
      "expected": true
    },
    {
      "description": "Levia's own class (Brute), no talent, is legal - CR 1.1.3 subset rule",
      "hero": "levia",
      "card": { "uid": "brute-action-red", "classes": ["Brute"], "talents": [] },
      "expected": true
    },
    {
      "description": "Shadow talent, no class, is legal for the Shadow hero Levia",
      "hero": "levia",
      "card": { "uid": "shadow-action-red", "classes": [], "talents": ["Shadow"] },
      "expected": true
    },
    {
      "description": "Brute + Shadow (hero's exact class and talent) is legal",
      "hero": "levia",
      "card": { "uid": "brute-shadow-action-red", "classes": ["Brute"], "talents": ["Shadow"] },
      "expected": true
    },
    {
      "description": "Brute + Chaos is illegal for Levia (Shadow Brute) - plan section 6.3's own example: 'not a Chaos Brute card'",
      "hero": "levia",
      "card": { "uid": "brute-chaos-action-red", "classes": ["Brute"], "talents": ["Chaos"] },
      "expected": false
    },
    {
      "description": "Wrong class alone (Ninja) is illegal for Levia (Brute)",
      "hero": "levia",
      "card": { "uid": "ninja-action-red", "classes": ["Ninja"], "talents": [] },
      "expected": false
    },
    {
      "description": "Wrong talent alone (Light) is illegal for Levia (Shadow)",
      "hero": "levia",
      "card": { "uid": "light-action-red", "classes": [], "talents": ["Light"] },
      "expected": false
    },
    {
      "description": "Levia Specialization card is legal for Levia (moniker match, single-word name)",
      "hero": "levia",
      "card": {
        "uid": "levia-signature-red",
        "classes": [],
        "talents": ["Shadow"],
        "specialization": "Levia"
      },
      "expected": true
    },
    {
      "description": "Viserai Specialization card is illegal for Levia (moniker mismatch)",
      "hero": "levia",
      "card": {
        "uid": "viserai-signature-red",
        "classes": [],
        "talents": ["Shadow"],
        "specialization": "Viserai"
      },
      "expected": false
    },
    {
      "description": "A banned-in-limited card is illegal even though otherwise legal for Levia",
      "hero": "levia",
      "card": { "uid": "banned-test-card-red", "classes": [], "talents": ["Shadow"] },
      "expected": false
    },
    {
      "description": "Generic card is always legal for Malice too",
      "hero": "malice",
      "card": { "uid": "generic-action-yellow", "classes": [], "talents": [] },
      "expected": true
    },
    {
